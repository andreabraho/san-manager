PORT=5000
# Use .env.development (MONGODB_URI ending in /san-manager-dev) for local dev
# Use .env.production or Render env vars (MONGODB_URI ending in /san-manager) for production
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/san-manager
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
# Google Gemini API key for AI chat widget (free at aistudio.google.com)
GEMINI_API_KEY=AIzaSyC9XYz5zCRBMfcd8sJ22t2P3SA9tpi3etg

# Nodemailer (e.g. Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=San Manager <noreply@sanmanager.com>

# Frontend URL (for email links)
CLIENT_URL=http://localhost:5173

# Cloudinary or local upload path
UPLOAD_PATH=uploads/

# First super admin (used only by seed:admin script)
SEED_ADMIN_EMAIL=admin@sanmanager.com
SEED_ADMIN_PASSWORD=changeme123
