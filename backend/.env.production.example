# Copy this to .env.production and fill in values,
# OR set these directly in the Render dashboard (recommended).

PORT=10000
NODE_ENV=production

# MongoDB Atlas — use /san-manager (production database)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/san-manager

# JWT — use a long random string (min 32 chars)
JWT_SECRET=<generate-with: openssl rand -hex 32>
JWT_EXPIRES_IN=7d

# Frontend URL (your Render static site URL)
CLIENT_URL=https://san-manager.onrender.com

# Backend URL (your Render web service URL, used for image URLs)
SERVER_URL=https://san-manager-api.onrender.com

# Groq AI (free at console.groq.com)
GROQ_API_KEY=gsk_...

# Email (Gmail App Password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=San Manager <noreply@yourdomain.com>

# Upload path
UPLOAD_PATH=uploads/
